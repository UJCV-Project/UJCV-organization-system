generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Professor {
  id          String                    @id @default(uuid())
  code        String                    @unique @db.VarChar(20)
  firstName   String                    @db.VarChar(50)
  lastName    String                    @db.VarChar(50)
  email       String                    @unique
  phoneNumber String                    @db.VarChar(20)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  status      String                    @default("Activo") @db.VarChar(10)
  available   ProfessorAvailableSlots[]
  schedule    Schedule[]
}

model ProfessorAvailableSlots {
  id          String    @id @default(uuid())
  professorId String
  day         Int
  startTime   Int
  endTime     Int
  professor   Professor @relation(fields: [professorId], references: [id])

  @@index([professorId, day])
  @@index([day, startTime])
}

model Degree {
  id         String       @id @default(uuid())
  code       String       @unique
  name       String
  status     DegreeStatus @default(activo)
  curriculum Curriculum[]
}

model Course {
  id            String       @id @default(uuid())
  code          String       @unique
  name          String
  unitValue     Int
  theoryHours   Int
  practiceHours Int
  status        CourseStatus @default(activo)
  curriculum    Curriculum[]
  Schedule      Schedule[]
}

model Curriculum {
  degreeId String
  courseId String
  semester Int?
  course   Course @relation(fields: [courseId], references: [id])
  degree   Degree @relation(fields: [degreeId], references: [id])

  @@id([degreeId, courseId])
}

model AcademicPeriod {
  id        String     @id @default(uuid())
  year      Int
  period    Int
  startDate DateTime
  endDate   DateTime
  schedules Schedule[]
}

model Room {
  id        String     @id @default(uuid())
  name      String     @db.VarChar(30)
  room_type String     @db.VarChar(30)
  capacity  Int        @db.SmallInt
  building  String     @db.VarChar(30)
  floor     Int        @db.SmallInt
  equipment String?    @default("") @db.VarChar
  schedules Schedule[]
}

model Schedule {
  id               String         @id @default(uuid())
  academicPeriodId String
  professorId      String
  courseId         String
  roomId           String
  section          String
  observations     String         @default("")
  events           Event[]
  academicPeriod   AcademicPeriod @relation(fields: [academicPeriodId], references: [id])
  course           Course         @relation(fields: [courseId], references: [id])
  professor        Professor      @relation(fields: [professorId], references: [id])
  room             Room           @relation(fields: [roomId], references: [id])

  @@index([academicPeriodId])
  @@index([professorId])
  @@index([roomId])
  @@index([courseId])
}

model Event {
  id         String   @id @default(uuid())
  scheduleId String
  day        Int
  startTime  Int
  endTime    Int
  schedule   Schedule @relation(fields: [scheduleId], references: [id])

  @@index([scheduleId])
}

enum DegreeStatus {
  activo
  inactivo
}

enum CourseStatus {
  activo
  inactivo
}
