generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Degree {
  id    String  @id @default(uuid())
  code  String  @unique
  name  String
  status DegreeStatus @default(activo)
  classes Course[]
}

enum DegreeStatus{
  activo
  inactivo
}

model Course {
  id        String  @id @default(uuid())
  code      String  @unique
  name      String
  credits   Int //Unidades Valorativas
  status CourseStatus @default(activo)
  degreeId  String
  degree    Degree  @relation(fields: [degreeId], references: [id])
}

enum CourseStatus{
  activo
  inactivo
}