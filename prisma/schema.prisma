generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


/* Professor Schema */ 
model Professor {
  id          String                    @id @default(uuid())
  code        String                    @unique @db.VarChar(20)
  firstName   String                    @db.VarChar(50)
  lastName    String                    @db.VarChar(50)
  email       String                    @unique
  phoneNumber String                    @db.VarChar(20)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  status      String                    @default("Activo") @db.VarChar(10)
  available   ProfessorAvailableSlots[]
  schedule    Schedule[]
}

model ProfessorAvailableSlots {
  id          String    @id @default(uuid())
  professorId String
  day         Int
  startTime   Int
  endTime     Int
  professor   Professor @relation(fields: [professorId], references: [id])

  @@index([professorId, day])
  @@index([day, startTime])
}


/* Course Schema */ 

model Degree {
  id         String       @id @default(uuid())
  code       String       @unique
  name       String
  status     DegreeStatus @default(activo)
  curriculum Curriculum[]
}

model Course {
  id            String       @id @default(uuid())
  code          String       @unique
  name          String
  unitValue     Int
  theoryHours   Int
  practiceHours Int
  status        CourseStatus @default(activo)
  curriculum    Curriculum[]
  Schedule      Schedule[]
}

model Curriculum {
  degreeId String
  courseId String
  semester Int?
  course   Course @relation(fields: [courseId], references: [id])
  degree   Degree @relation(fields: [degreeId], references: [id])

  @@id([degreeId, courseId])
}


model AcademicPeriod {
  id        String     @id @default(uuid())
  year      Int
  period    Int
  startDate DateTime
  endDate   DateTime
  schedules Schedule[]
}

model Room {
  id        String     @id @default(uuid())
  name      String     @default("") @db.VarChar(30)
  room_type String     @default("") @db.VarChar(30)
  capacity  Int        @default(0) @db.SmallInt
  building  String     @default("") @db.VarChar(30)
  floor     Int        @default(1) @db.SmallInt
  equipment String?    @default("") @db.VarChar
  schedules Schedule[]
}

model Schedule {
  id               String         @id @default(uuid())
  academicPeriodId String
  professorId      String
  courseId         String
  roomId           String
  section          String
  observations     String         @default("")
  events           Event[]
  academicPeriod   AcademicPeriod @relation(fields: [academicPeriodId], references: [id])
  course           Course         @relation(fields: [courseId], references: [id])
  professor        Professor      @relation(fields: [professorId], references: [id])
  room             Room           @relation(fields: [roomId], references: [id])

  @@index([academicPeriodId])
  @@index([professorId])
  @@index([roomId])
  @@index([courseId])
}

model Event {
  id         String   @id @default(uuid())
  scheduleId String
  day        Int
  startTime  Int
  endTime    Int
  schedule   Schedule @relation(fields: [scheduleId], references: [id])

  @@index([scheduleId])
}




/* Auth Schema*/

model User {
  userId        String        @id @default(uuid())  
  email         String     @unique
  passwordHash  String?    // Password hash (nullable for OAuth)
  oauthProvider String?    // OAuth provider (nullable if not using OAuth)
  oauthId       String?    
  firstName     String     
  lastName      String
  picture       String?     
  roleId        String        
  role          Role       @relation(fields: [roleId], references: [roleId])  
  createdAt     DateTime   @default(now())  
  updatedAt     DateTime   @updatedAt 
  lastLogin     DateTime?  
}

model Role {
  roleId   String      @id @default(uuid())  
  roleName String   @unique
  description String?  
  users    User[]   
  permissions RolePermission[] 
}

model Permission {
  permissionId   String      @id @default(uuid())  
  permissionName String   @unique  // Name of the permission (e.g., "can_edit_schedule")
  roles          RolePermission[]   
}

model RolePermission {
  roleId        String
  permissionId  String
  role          Role       @relation(fields: [roleId], references: [roleId])
  permission    Permission @relation(fields: [permissionId], references: [permissionId])
  @@id([roleId, permissionId]) 
}


enum DegreeStatus {
  activo
  inactivo
}

enum CourseStatus {
  activo
  inactivo
}
